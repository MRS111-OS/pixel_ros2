    <axis xyz="0 0 0"/>
  </joint>

  <!-- ==================== DEPTH CAMERA LINK ==================== -->
  <link name="depth_camera_link">
    <inertial>
      <origin xyz="-0.000712678854943624 -9.38939025944413E-05 -1.55824763992951E-05" rpy="0 0 0"/>
      <mass value="0.000991736484143312"/>
      <inertia ixx="5.50764533830036E-07" ixy="1.95266937469792E-11" ixz="-6.83710791539321E-14"
