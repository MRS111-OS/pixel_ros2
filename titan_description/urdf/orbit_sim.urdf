      </geometry>
    </collision>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <origin xyz="0.20867 0 0.064016" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ==================== GAZEBO PLUGINS ==================== -->

  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- ................... DIFFERENTIAL DRIVE PLUGIN ................... -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>right_wheel_joint</left_joint>
      <right_joint>left_wheel_joint</right_joint>
      <wheel_separation>0.304</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libignition-gazebo6-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- ==================== LIDAR SENSOR ==================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <update_rate>5</update_rate>
      <visualize>true</visualize>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>15.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================== DEPTH CAMERA SENSOR ==================== -->
  <gazebo reference="depth_camera_link">
    <sensor type="depth_camera" name="kinect_camera">
      <update_rate>30.0</update_rate>
      <topic>kinect_camera</topic>
      <ignition_frame_id>kinect_camera</ignition_frame_id>
      <camera_info_topic>kinect_camera/camera_info</camera_info_topic>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

