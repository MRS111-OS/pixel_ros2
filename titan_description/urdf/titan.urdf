        <!-- <mesh filename="package://titan_description/meshes/titan_meshes/Left_Wheel_Link.STL"/> -->
        <cylinder radius="0.034843" length="0.02"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.57 1.57"/>
      <geometry>
        <!-- <mesh filename="package://titan_description/meshes/titan_meshes/Left_Wheel_Link.STL"/> -->
        <cylinder radius="0.034843" length="0.02"/>
