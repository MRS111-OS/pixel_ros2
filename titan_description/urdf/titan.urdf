    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://titan_description/meshes/titan_meshes/base_link.STL"/>
      </geometry>
      <material name="light_black"/>
