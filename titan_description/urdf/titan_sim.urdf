<?xml version="1.0" encoding="utf-8"?>

<robot name="titan">

  <!-- ================= MATERIALS (from titan.urdf) ================= -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <material name="chassis_black">
    <color rgba="0.145 0.145 0.169 1.0"/>
  </material>

  <material name="tire_black">
    <color rgba="0.039 0.039 0.039 1.0"/>
  </material>

  <material name="sensor_black">
    <color rgba="0.067 0.067 0.078 1.0"/>
  </material>

  <material name="caster_nylon">
    <color rgba="0.91 0.90 0.85 1.0"/>
  </material>

  <!-- ================= BASE ================= -->

  <link name="base_footprint"/>

  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">

    <!-- MASS UPDATED TO MATCH titan.urdf -->
    <inertial>
      <origin xyz="0.00346341261510518 -0.000431167248793353 0.0900728026786845" rpy="0 0 0"/>
      <mass value="2.920547254934799"/>
      <inertia ixx="0.00396950657190701"
               ixy="3.24338418795685E-06"
               ixz="1.91406169796034E-05"
               iyy="0.00366159045993355"
               iyz="-1.43363832997866E-06"
               izz="0.00731329773396938"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/base_link.STL"/>
      </geometry>
      <material name="chassis_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/base_link.STL"/>
      </geometry>
    </collision>

  </link>

  <!-- ================= LEFT WHEEL ================= -->

  <link name="Right_Wheel_Link">
    <inertial>
      <origin xyz="1.8457E-10 0.0002899 3.6055E-10" rpy="0 0 0"/>
      <mass value="0.035175"/>
      <inertia ixx="1.5237E-05"
               ixy="-1.9322E-13"
               ixz="-4.4739E-10"
               iyy="2.5786E-05"
               iyz="-5.0197E-14"
               izz="1.5237E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 1.57 1.57"/>
      <geometry>
        <cylinder radius="0.034843" length="0.02"/>
      </geometry>
      <material name="tire_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.57 1.57"/>
      <geometry>
        <cylinder radius="0.034843" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="Right_Wheel_Joint" type="continuous">
    <origin xyz="-0.0001 -0.09075 0.022" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Right_Wheel_Link"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.5" velocity="22"/>
  </joint>

  <!-- ================= RIGHT WHEEL ================= -->

  <link name="Left_Wheel_Link">
    <inertial>
      <origin xyz="-4.6789E-09 -3.9895E-05 4.607E-09" rpy="0 0 0"/>
      <mass value="0.035175"/>
      <inertia ixx="1.5237E-05"
               ixy="-1.4328E-12"
               ixz="-4.4388E-10"
               iyy="2.5786E-05"
               iyz="1.1122E-12"
               izz="1.5237E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 1.57 1.57"/>
      <geometry>
        <cylinder radius="0.034843" length="0.02"/>
      </geometry>
      <material name="tire_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.57 1.57"/>
      <geometry>
        <cylinder radius="0.034843" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="Left_Wheel_Joint" type="continuous">
    <origin xyz="-0.0001 0.0905 0.022" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Left_Wheel_Link"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.5" velocity="22"/>
  </joint>

    <!-- ================= RGB CAMERA ================= -->

  <link name="RGB_Camera_Link">
    <inertial>
      <origin xyz="-0.0078063 -3.8623E-06 -0.0010259" rpy="0 0 0"/>
      <mass value="0.01352"/>
      <inertia ixx="2.5544E-06"
               ixy="-3.5783E-12"
               ixz="1.7676E-07"
               iyy="1.5924E-06"
               iyz="1.8649E-10"
               izz="1.2081E-06"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="RGB_Camera_Joint" type="fixed">
    <origin xyz="0.10 0 0.12" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="RGB_Camera_Link"/>
  </joint>

  <!-- ================= DEPTH CAMERA ================= -->

  <link name="Depth_Camera_Link">
    <inertial>
      <origin xyz="-0.010806 4.7404E-05 -0.00030365" rpy="0 0 0"/>
      <mass value="0.081395"/>
      <inertia ixx="6.286E-05"
               ixy="-1.3972E-08"
               ixz="6.8703E-08"
               iyy="5.5976E-06"
               iyz="2.1844E-08"
               izz="6.1887E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Depth_Camera_Link.STL"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Depth_Camera_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Depth_Camera_Joint" type="fixed">
    <origin xyz="0.063825 0.00022394 0.20111" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Depth_Camera_Link"/>
  </joint>

  <!-- ================= FRONT CASTER ================= -->

  <link name="Front_Caster_Link">
    <inertial>
      <origin xyz="0.00020286 -1.2503E-05 0.0041777" rpy="0 0 0"/>
      <mass value="0.0024002"/>
      <inertia ixx="8.6259E-08"
               ixy="-2.1714E-12"
               ixz="6.7243E-13"
               iyy="8.7002E-08"
               iyz="1.0021E-10"
               izz="1.0084E-07"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Front_Caster_Link.STL"/>
      </geometry>
      <material name="caster_nylon"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Front_Caster_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Front_Caster_Joint" type="fixed">
    <origin xyz="-0.099797 0 -0.005" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Front_Caster_Link"/>
  </joint>

  <!-- ================= REAR CASTER ================= -->

  <link name="Rear_Caster_Link">
    <inertial>
      <origin xyz="-8.2468E-08 -0.00021544 0.0041777" rpy="0 0 0"/>
      <mass value="0.0024002"/>
      <inertia ixx="8.6259E-08"
               ixy="-2.1714E-12"
               ixz="6.7243E-13"
               iyy="8.7002E-08"
               iyz="1.0021E-10"
               izz="1.0084E-07"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Rear_Caster_Link.STL"/>
      </geometry>
      <material name="caster_nylon"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Rear_Caster_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Rear_Caster_Joint" type="fixed">
    <origin xyz="0.1 -0.00020294 -0.005" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Rear_Caster_Link"/>
  </joint>

  <!-- ================= LIDAR ================= -->

  <link name="Lidar_Link">
    <inertial>
      <origin xyz="-0.00056498 -1.4613E-05 -0.011701" rpy="0 0 0"/>
      <mass value="0.16538"/>
      <inertia ixx="7.8865E-05"
               ixy="4.8468E-08"
               ixz="2.1847E-06"
               iyy="7.519E-05"
               iyz="2.8859E-08"
               izz="0.00010995"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Lidar_Link.STL"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find titan_description)/meshes/titan_meshes/Lidar_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Lidar_Joint" type="fixed">
    <origin xyz="0.065 0 0.15166" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Lidar_Link"/>
  </joint>

  <gazebo>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        </plugin>

        <!-- ........................... DIFFERENTIAL DRIVE PLUGIN ................................... -->

        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>Left_Wheel_Joint</left_joint>
            <right_joint>Right_Wheel_Joint</right_joint>
            <wheel_separation>0.18</wheel_separation>
            <wheel_radius>0.034843</wheel_radius>
            <odom_publish_frequency>30</odom_publish_frequency>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
        </plugin>
  </gazebo>

<gazebo>
  <plugin filename="libignition-gazebo6-odometry-publisher-system"
          name="ignition::gazebo::systems::OdometryPublisher">

    <odom_frame>odom</odom_frame>
    <robot_base_frame>base_footprint</robot_base_frame>

    <odom_topic>/odom</odom_topic>
    <tf_topic>/tf</tf_topic>

    <dimensions>2</dimensions>
    <odom_publish_frequency>30</odom_publish_frequency>

  </plugin>
</gazebo>

<gazebo reference="Lidar_Link">
    <sensor name="lidar" type="gpu_lidar">
  
      <update_rate>5</update_rate>
      <visualize>true</visualize>

      <ignition_frame_id>Lidar_Link</ignition_frame_id> 

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.3</min>
          <max>15.0</max>
          <resolution>0.015</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>

    </sensor>
  </gazebo>

  <gazebo reference="Depth_Camera_Link">
            <sensor type="depth_camera" name="kinect_camera">
                <update_rate>30.0</update_rate>
                <topic>kinect_camera</topic>
                <ignition_frame_id>kinect_camera</ignition_frame_id>
                <camera_info_topic>kinect_camera/camera_info</camera_info_topic>
                <camera>
                    <horizontal_fov>1.57</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>8.0</far>
                    </clip>
                </camera>
            </sensor>
  </gazebo>

  <gazebo reference="RGB_Camera_Link">
            <sensor type="camera" name="right">
                <update_rate>10.0</update_rate>
                <always_on>true</always_on>
                <ignition_frame_id>stereo_camera_optical</ignition_frame_id>
                <pose>0 0 0 0 0 0</pose>
                <topic>camera/color/image_raw</topic>
                <camera_info_topic>camera/color/camera_info</camera_info_topic>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>1024</width>
                    <height>1024</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>20</far>
                </clip>
            </sensor>

            <!-- <sensor type="camera" name="left">
                <topic>camera/color/image_raw</topic>
                <update_rate>10.0</update_rate>
                <always_on>true</always_on>
                <ignition_frame_id>stereo_camera_optical</ignition_frame_id>
                <camera_info_topic>camera/color/camera_info</camera_info_topic>
                <pose>0 0 0 0 0 0</pose>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>1024</width>
                    <height>1024</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>20</far>
                </clip>
            </sensor> -->
  </gazebo>

<gazebo reference="Right_Wheel_Link">
  <visual>
    <material>
      <ambient>0.01 0.01 0.01 1</ambient>
      <diffuse>0.02 0.02 0.02 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
    </material>
  </visual>
</gazebo>

<gazebo reference="Left_Wheel_Link">
  <visual>
    <material>
      <ambient>0.01 0.01 0.01 1</ambient>
      <diffuse>0.02 0.02 0.02 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
    </material>
  </visual>
</gazebo>

<gazebo reference="base_link">
  <visual>
    <material>
      <ambient>0.04 0.04 0.05 1</ambient>
      <diffuse>0.07 0.07 0.08 1</diffuse>
      <specular>0.08 0.08 0.09 1</specular>
    </material>
  </visual>
</gazebo>

<gazebo reference="Front_Caster_Link">
  <visual>
    <material>
      <ambient>0.45 0.45 0.42 1</ambient>
      <diffuse>0.91 0.90 0.85 1</diffuse>
      <specular>0.12 0.12 0.10 1</specular>
    </material>
  </visual>
  <collision>
    <surface>
      <friction>
        <ode>
          <mu>0.001</mu>
          <mu2>0.001</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
</gazebo>

<gazebo reference="Rear_Caster_Link">
  <visual>
    <material>
      <ambient>0.45 0.45 0.42 1</ambient>
      <diffuse>0.91 0.90 0.85 1</diffuse>
      <specular>0.12 0.12 0.10 1</specular>
    </material>
  </visual>
  <collision>
    <surface>
      <friction>
        <ode>
          <mu>0.001</mu>
          <mu2>0.001</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
</gazebo>

<gazebo reference="Depth_Camera_Link">
  <visual>
    <material>
      <ambient>0.02 0.02 0.02 1</ambient>
      <diffuse>0.03 0.03 0.04 1</diffuse>
      <specular>0.08 0.08 0.09 1</specular>
    </material>
  </visual>
</gazebo>

<gazebo reference="RGB_Camera_Link">
  <visual>
    <material>
      <ambient>0.02 0.02 0.02 1</ambient>
      <diffuse>0.03 0.03 0.04 1</diffuse>
      <specular>0.08 0.08 0.09 1</specular>
    </material>
  </visual>
</gazebo>

<gazebo reference="Lidar_Link">
  <visual>
    <material>
      <ambient>0.02 0.02 0.02 1</ambient>
      <diffuse>0.03 0.03 0.04 1</diffuse>
      <specular>0.08 0.08 0.09 1</specular>
    </material>
  </visual>
</gazebo>

</robot>