<mass value="0.0350810902282031"/>
<inertia ixx="1.9431042344715E-05" ixy="1.25786951065319E-09" ixz="4.0727250375758E-08" iyy="1.93204818984074E-05" iyz="-8.99327108692352E-10" izz="3.70178943801405E-05"/>
