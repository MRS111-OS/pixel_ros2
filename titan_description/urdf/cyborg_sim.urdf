<mesh filename="file://$(find titan_description)/meshes/cyborg_meshes/left_wheel.dae"/>
</geometry>
<material name="">
<color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
</material>
</visual>
<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<mesh filename="file://$(find titan_description)/meshes/cyborg_meshes/left_wheel.dae"/>
</geometry>
</collision>
</link>
<joint name="left_wheel_joint" type="continuous">
<origin xyz="-0.0012004 0.191 0.0175" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="left_wheel_link"/>
<axis xyz="0 -1 0"/>
</joint>
<!--
 ==================== RIGHT WHEEL LINK ==================== 
-->
<link name="right_wheel_link">
<inertial>
<origin xyz="-3.98100425862755E-18 0.0032826783833011 -1.38777878078145E-17" rpy="0 0 0"/>
