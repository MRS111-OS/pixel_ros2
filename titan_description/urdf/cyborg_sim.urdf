<!--
 ==================== DEPTH CAMERA LINK ==================== 
-->
<link name="depth_cam_link">
<inertial>
<origin xyz="0.064482642250883 -0.235348177523985 0.012999999999993" rpy="0 0 0"/>
<mass value="0.00429034247102725"/>
<inertia ixx="5.16068679378573E-07" ixy="-9.00020868857573E-08" ixz="9.25342039025307E-23" iyy="4.07444040874538E-07" iyz="-2.48203992665716E-23" izz="3.5663641118096E-07"/>
</inertial>
