<robot name="cyborg2_urdf">
<!--
 ==================== BASE LINK ==================== 
-->
<link name="base_link" xmlns:xacro="http://www.ros.org/wiki/xacro">
<inertial>
<origin xyz="0.000388995106410144 -0.000141279341706429 0.0688665645440425" rpy="0 0 0"/>
<mass value="15.64730629951199"/>
<inertia ixx="0.150309156083533" ixy="-2.99010712658331E-05" ixz="-0.000120003782573757" iyy="0.254414025413635" iyz="6.4791912058523E-06" izz="0.384323256909858"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<mesh filename="file://$(find titan_description)/meshes/cyborg_meshes/base_link.dae"/>
</geometry>
<material name="">
<color rgba="0.964705882352941 0.964705882352941 0.952941176470588 1"/>
</material>
</visual>
<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<mesh filename="file://$(find titan_description)/meshes/cyborg_meshes/base_link.dae"/>
</geometry>
</collision>
</link>
<!--
 ==================== LEFT WHEEL LINK ==================== 
-->
<link name="left_wheel_link">
<inertial>
<origin xyz="-1.13022519888901E-16 -0.00328267838330104 -1.38777878078145E-17" rpy="0 0 0"/>
<mass value="2.70332620354124"/>
<inertia ixx="0.00340221851301933" ixy="5.66785505934065E-17" ixz="-1.15638390824567E-20" iyy="0.00502830835977674" iyz="9.44159258159988E-21" izz="0.00343951566972418"/>
</inertial>
