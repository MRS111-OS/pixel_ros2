[Unit]
Description=Reverse SSH Tunnel (auto-user)
After=network.target

[Service]
Type=simple
Environment=USER_NAME=%u
ExecStart=/bin/bash -c '/usr/bin/ssh \
  -o "ServerAliveInterval=60" \
  -o "ServerAliveCountMax=3" \
  -o "StrictHostKeyChecking=accept-new" \
  -i /home/${USER_NAME}/.ssh/proxyjumper_tahjzf6z \
  -N -R /IPC1:localhost:22 tahjzf6z@api2.proxypilot.org'
Restart=always
RestartSec=10
User=%u

[Install]
WantedBy=multi-user.target
