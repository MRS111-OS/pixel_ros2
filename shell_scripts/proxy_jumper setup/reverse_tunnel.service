[Unit]
Description=Reverse SSH Tunnel (auto-user)
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c '\
  USER_NAME=$(whoami) && \
  source /home/${USER_NAME}/.ssh/reverse_ssh.conf && \
  exec /usr/bin/ssh \
    -o "ServerAliveInterval=60" \
    -o "ServerAliveCountMax=3" \
    -o "StrictHostKeyChecking=accept-new" \
    -i /home/${USER_NAME}/.ssh/proxyjumper_${PROXY_USER} \
    -N -R /${IDENTIFIER}:localhost:22 ${PROXY_USER}@${PROXY_HOST}'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
